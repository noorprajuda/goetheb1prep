{
  "name": "SpeakingTest",
  "type": "object",
  "properties": {
    "test_type": {
      "type": "string",
      "enum": [
        "full_test",
        "practice",
        "part_1",
        "part_2"
      ],
      "description": "Type of speaking test taken"
    },
    "task_topic": {
      "type": "string",
      "description": "Topic of the speaking task"
    },
    "audio_url": {
      "type": "string",
      "description": "URL to the recorded audio file"
    },
    "transcript": {
      "type": "string",
      "description": "Transcribed text from the audio"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Duration of the recording in seconds"
    },
    "scores": {
      "type": "object",
      "properties": {
        "fluency": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "vocabulary": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "grammar": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "pronunciation": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "task_completion": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "feedback": {
      "type": "object",
      "properties": {
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "areas_for_improvement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specific_feedback": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "passed": {
      "type": "boolean",
      "description": "Whether the test meets B1 standards"
    }
  },
  "required": [
    "test_type",
    "task_topic"
  ]
}